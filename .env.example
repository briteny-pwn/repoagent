# Generate actual secrets with scripts/init_deployment.py. Never commit .env.
ADMIN_PASSWORD=
ENCRYPTION_KEY=
SECURE_COOKIE=true
DATA_DIR=/data
# Use your domain pointing at 101.132.153.33 (no scheme for automatic HTTPS).
SITE_ADDRESS=steward.example.com
ALLOWED_PROXY_HOSTS=127.0.0.1
MIHOMO_CONTROLLER_URL=http://127.0.0.1:9090
MIHOMO_CONTROLLER_SECRET=
MIHOMO_CONFIG_PATH=/data/proxy/config.yaml
MIHOMO_PROXY_URL=http://127.0.0.1:7890
# Set an explicitly tested tag/digest before production rollout.
MIHOMO_IMAGE=metacubex/mihomo:latest
