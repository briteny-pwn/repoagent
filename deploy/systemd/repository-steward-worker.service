[Unit]
Description=Repository Steward background Agent
After=network-online.target repository-steward-api.service
Wants=network-online.target
[Service]
Type=simple
User=steward
Group=steward
WorkingDirectory=/opt/repository-steward
EnvironmentFile=/opt/repository-steward/.env
Environment=PYTHONPATH=/opt/repository-steward/backend
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/repository-steward/.venv/bin/python -m app.worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/repository-steward/data
UMask=0077
MemoryMax=256M
[Install]
WantedBy=multi-user.target
